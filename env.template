# Copy this file to .env for local development.
# Example: cp env.template .env

# region ===== Server =====
APP_PORT=8080
# endregion

# region ===== Redis (local Docker port mapping) =====
REDIS_HOST=localhost
REDIS_PORT=6379
# endregion

# region ===== Kafka (local Docker port mapping) =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# endregion

# region ===== PostgreSQL (local Docker port mapping) =====
DB_URL=jdbc:postgresql://localhost:5432/mydb
DB_USERNAME=myuser
DB_PASSWORD=mypassword
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
# endregion

# region ===== Google OAuth2 (Required) =====
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# endregion

# region ===== Auth Redirect =====
APP_AUTH_DEFAULT_REDIRECT_URL=/swagger-ui/index.html
APP_AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# endregion
